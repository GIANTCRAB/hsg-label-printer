extends layout
block content
    .page-header
        h2 PDF Printer
        p Upload a PDF and choose a printer to send it to.

    .label-grid
        .card
            .card-title
                svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                    path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
                    polyline(points="14 2 14 8 20 8")
                | Upload PDF
            .drop-zone#pdfDropZone
                input#pdfUpload(name="pdf-file", type="file", accept=".pdf,application/pdf")
                svg.drop-zone-icon(xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                    path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
                    polyline(points="14 2 14 8 20 8")
                .drop-zone-text
                    strong Click to upload
                    |  or drag &amp; drop
                .drop-zone-hint PDF files only
            .file-preview#pdfFilePreview
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                    path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
                    polyline(points="14 2 14 8 20 8")
                span.file-preview-name
                button.file-preview-remove(type="button", aria-label="Remove file")
                    svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        line(x1="18" y1="6" x2="6" y2="18")
                        line(x1="6" y1="6" x2="18" y2="18")

        .controls
            .card
                .card-title
                    svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="6 9 6 2 18 2 18 9")
                        path(d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2")
                        rect(x="6" y="14" width="12" height="8")
                    | Select Printer
                .printer-options#printerOptions
                    label.printer-option.selected
                        input(type="radio", name="printer-name", value="LabelWriter_4XL", checked)
                        .printer-option-info
                            .printer-option-name Label Printer
                            .printer-option-desc DYMO LabelWriter 4XL — 4×6″ labels
                        svg.printer-option-icon(xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                            rect(x="3" y="3" width="18" height="18" rx="2" ry="2")
                            line(x1="3" y1="9" x2="21" y2="9")
                    label.printer-option
                        input(type="radio", name="printer-name", value="DocuPrint_3055_A4_PDF")
                        .printer-option-info
                            .printer-option-name B&W Printer
                            .printer-option-desc Xerox DocuPrint 3055 — A4 black &amp; white
                        svg.printer-option-icon(xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                            polyline(points="6 9 6 2 18 2 18 9")
                            path(d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2")
                            rect(x="6" y="14" width="12" height="8")
                    label.printer-option
                        input(type="radio", name="printer-name", value="EPSON_L455_Series")
                        .printer-option-info
                            .printer-option-name Color Printer
                            .printer-option-desc Epson L455 — A4 color inkjet
                        svg.printer-option-icon(xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                            circle(cx="12" cy="12" r="10")
                            circle(cx="12" cy="12" r="3")

            button.btn.btn-primary.btn-lg.btn-block#submitPdf
                svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="6 9 6 2 18 2 18 9")
                    path(d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2")
                    rect(x="6" y="14" width="12" height="8")
                span.btn-label Print PDF

    script(src='/javascripts/pdf.js')
