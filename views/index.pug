extends layout
block content
    .page-header
        h2 Label Printer
        p Design a label by uploading an image and adding text, then print it on the DYMO LabelWriter.

    .label-grid
        .canvas-wrap
            canvas#myCanvas(width="800", height="1200")
            .canvas-actions
                button.btn.btn-outline#clearCanvas
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        path(d="M3 6h18")
                        path(d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6")
                        path(d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2")
                    | Clear Canvas

        .controls
            .card
                .card-title
                    svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        rect(x="3" y="3" width="18" height="18" rx="2" ry="2")
                        circle(cx="8.5" cy="8.5" r="1.5")
                        polyline(points="21 15 16 10 5 21")
                    | Upload Image
                .drop-zone#imageDropZone
                    input#pictureToCanvas(type="file", accept="image/*")
                    svg.drop-zone-icon(xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
                        path(d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4")
                        polyline(points="17 8 12 3 7 8")
                        line(x1="12" y1="3" x2="12" y2="15")
                    .drop-zone-text
                        strong Click to upload
                        |  or drag &amp; drop
                    .drop-zone-hint PNG, JPG, GIF — any size
                .file-preview#imageFilePreview
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        rect(x="3" y="3" width="18" height="18" rx="2" ry="2")
                        circle(cx="8.5" cy="8.5" r="1.5")
                        polyline(points="21 15 16 10 5 21")
                    span.file-preview-name
                    button.file-preview-remove(type="button", aria-label="Remove file")
                        svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            line(x1="18" y1="6" x2="6" y2="18")
                            line(x1="6" y1="6" x2="18" y2="18")

            .card
                .card-title
                    svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="4 7 4 4 20 4 20 7")
                        line(x1="9" y1="20" x2="15" y2="20")
                        line(x1="12" y1="4" x2="12" y2="20")
                    | Add Text
                .form-group
                    label.form-label(for="textInput") Label Text
                    textarea.form-textarea#textInput(placeholder="Type your label text here…\nEach line will be rendered separately.")
                button.btn.btn-accent.btn-block#updateText(style="margin-top:.75rem")
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="4 7 4 4 20 4 20 7")
                        line(x1="9" y1="20" x2="15" y2="20")
                        line(x1="12" y1="4" x2="12" y2="20")
                    | Render Text on Label

            button.btn.btn-primary.btn-lg.btn-block#submitImage
                svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="6 9 6 2 18 2 18 9")
                    path(d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2")
                    rect(x="6" y="14" width="12" height="8")
                span.btn-label Print Label

    script(src='/javascripts/index.js')
